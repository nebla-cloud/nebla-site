    "check:layout": "node scripts/check-layout.mjs",
    "brand": "node brand/build.mjs"
  },
  "devDependencies": {
    "@fontsource/onest": "^5.3.1",
    "@iconify-json/lucide": "^1.2.157",
    "@iconify-json/simple-icons": "^1.2.103",
    "@nuxt/eslint": "1.17.0",
    "@resvg/resvg-js": "2.6.2",
    "eslint": "^10.15.0",
    "node-html-parser": "9.0.7",
    "opentype.js": "2.0.0",
    "playwright-core": "1.65.1",
    "png-to-ico": "3.0.2",
    "serve": "^14.2.8",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@nuxt/content": "3.17.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/ui": "4.13.0",
    "better-sqlite3": "^13.2.0",
    "nuxt": "4.6.4",
